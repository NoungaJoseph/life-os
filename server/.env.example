NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Supabase (server side only; never ship the service role key in a client app)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# Optional AI coach (Claude). Leave blank to disable; predictions still work.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
ENABLE_SCHEDULER=false   # true on exactly one instance to send reminder push notifications
API_RATE_LIMIT=120        # requests per minute per IP

# Wallet payments. Keep all provider credentials on the server.
PAYMENTS_MODE=sandbox
PAYMENTS_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
SANDBOX_PAYMENT_DELAY_MS=800
SANDBOX_PAYMENT_SUCCESS_RATE=1
MTN_MOMO_API_KEY=
ORANGE_MONEY_API_KEY=
